# Stash Backend Configuration (Copy to .env for local overrides; never commit .env)
STASH_PORT=4000
STASH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STASH_TEMP_DIR=/tmp/stash-jobs
STASH_MAX_CONCURRENT_JOBS=4
STASH_MAX_CONCURRENT_TRACKS=4
STASH_FRAGMENTS_SINGLE=8
STASH_FRAGMENTS_PLAYLIST=4
STASH_CACHE_TTL_SECONDS=600
STASH_JOB_TTL_MINUTES=30
STASH_TRUST_PROXY=true

# Optional binary overrides (auto-detected from PATH if unset)
# STASH_YTDLP_BIN=/home/user/.local/bin/yt-dlp
# STASH_FFMPEG_BIN=/usr/bin/ffmpeg
# STASH_JS_RUNTIME=deno

# Optional VPS / anti-bot configuration
# STASH_POT_PROVIDER_URL=http://pot-provider:4416
# STASH_COOKIES_FILE=/data/cookies.txt
# STASH_PROXY_URL=
